{
  "name": "DevSecOps Lab Container",
  "build": { 
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8000],

  // 1. FEATURES: This is the modern way to add tools
  "features": {},

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": ["${workspaceFolder}"]
      },
      "extensions": [
        "ms-playwright.playwright",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",        
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  
  // Use your Makefile to finish any local setup
  "postCreateCommand": "make install"
}