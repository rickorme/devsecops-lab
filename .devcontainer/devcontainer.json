{
  // Name the container environment
  "name": "DevSecOps Lab Container",

  // Use a base image that already includes Node.js
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  // Ensure both Node deps and Python deps are installed after container creation
  "postCreateCommand": "npm install && python -m pip install --upgrade pip setuptools wheel && if [ -f requirements.txt ]; then pip install -r requirements.txt; else pip install fastapi uvicorn[standard]; fi",

  // Forward the FastAPI default port
  "forwardPorts": [8000],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-playwright.playwright",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ritwickdey.LiveServer"
      ]
    }
  },
  
// 1. FEATURES SECTION (must be a complete object)
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
    // ... other features ...
  }, // <-- The features block ends here!

  // 2. CONTAINER ENV SECTION (must be a separate, top-level property)
  "containerEnv": {
    "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock"
  },

  // 3. RUN ARGS SECTION (must be a separate, top-level property)
  "runArgs": [
    "-v", 
    "${env:SSH_AUTH_SOCK}:/tmp/ssh-agent.sock"
  ]
}