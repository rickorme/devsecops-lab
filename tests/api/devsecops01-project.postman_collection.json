		{
			"name": "GET test user info",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"const expectedId = pm.variables.get(\"test_user_id\");",
							"",
							"// Validate that the response code should be 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Validate that the response is json object",
							"pm.test(\"Response is a json object\", function () {",
							"    pm.expect(jsonData).to.be.an('object');",
							"});",
							"",
							"// Validate that the response has an arg object",
							"pm.test(\"Response to have 'id' object\", function () {",
							"    pm.expect(jsonData).to.have.property('id');",
							"});",
							"",
							"// Validate that the response has url property",
							"pm.test(\"id to match the test_user_id\", function () {",
							"    ",
							"    pm.expect(jsonData.id).to.equal(expectedId);",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{test_access_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/users/me",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"me"
					]
				},
				"description": "The tests in this request validate that:\n\n- the response code is 200\n- the response is a JSON object\n- the response has an 'arg' object\n- the response has 'headers' object\n- the response has a 'URL' property"
			},
			"response": []
		},
		{
			"name": "POST Create a post",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const jsonData = pm.response.json();",
							"",
							"pm.test(\"Returns valid UUID and metadata\", function () {",
							"    pm.expect(jsonData.id).to.be.a('string');",
							"    pm.expect(jsonData.id).to.have.lengthOf(36); // UUID length",
							"    pm.expect(jsonData.caption).to.not.be.null;",
							"});",
							"",
							"// Store the new Post ID to use in the NEXT request",
							"pm.collectionVariables.set(\"latest_post_id\", jsonData.id);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{test_access_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": "{{image_path}}/wild-shiitake-mushroom-4836310_640.jpg"
						},
						{
							"key": "caption",
							"value": "{{caption_1}}",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/posts/create",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"posts",
						"create"
					]
				},
				"description": "The tests in this request validate that:\n\n- the response code is 200\n- the response is a JSON object\n- the response has an 'arg' object\n- the response has 'headers' object\n- the response has a 'URL' property"
			},
			"response": []
		},
		{
			"name": "GET Feed",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"// Validate that the response code should be 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Validate that the response is json object",
							"pm.test(\"Response is a json object\", function () {",
							"    pm.expect(jsonData).to.be.an('object');",
							"});",
							"",
							"// Validate that the response has an arg object",
							"pm.test(\"Check object has expected properties\", function () {",
							"    pm.expect(jsonData).to.have.property('posts');",
							"    pm.expect(jsonData.posts[0]).to.have.property('id');",
							"    pm.expect(jsonData.posts[0]).to.have.property('user_id');",
							"    pm.expect(jsonData.posts[0]).to.have.property('caption');",
							"    pm.expect(jsonData.posts[0]).to.have.property('file_type');",
							"    pm.expect(jsonData.posts[0]).to.have.property('file_name');",
							"    pm.expect(jsonData.posts[0]).to.have.property('content_type');",
							"    pm.expect(jsonData.posts[0]).to.have.property('created_at');",
							"    pm.expect(jsonData.posts[0]).to.have.property('is_owner');",
							"    pm.expect(jsonData.posts[0]).to.have.property('email');",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
