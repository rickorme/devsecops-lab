		{
			"name": "JWT Login bad credentials",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Validate that the response code should be 200",
							"pm.test(\"Response Code should be 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Error message should be LOGIN_BAD_CREDENTIALS\", () => {",
							"    pm.expect(pm.response.json().detail).to.equal('LOGIN_BAD_CREDENTIALS')",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
