		{
			"name": "PUT Update a post",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const jsonData = pm.response.json();",
							"const old_caption = pm.variables.get(\"caption_1\");",
							"const new_caption = pm.variables.get(\"caption_2\");",
							"",
							"pm.test(\"Caption has changed to the new value\", function () {",
							"    pm.expect(jsonData.caption).to.be.equal(new_caption);",
							"});",
							""
						],
						"type": "text/javascript",
